# ============================================================
# SIMONEV Boyolali — Contoh Environment Variables
# Salin file ini menjadi .env.local di masing-masing apps/ops
# dan apps/eksekutif, lalu isi sesuai lingkungan (dev/staging/prod).
# ============================================================

# --- MongoDB ---
# Database transaksional (dipakai oleh apps/ops)
MONGODB_URI_CORE=mongodb://localhost:27017/simonev_core

# Database read-model (dipakai oleh apps/eksekutif, ditulis oleh worker)
MONGODB_URI_READMODEL=mongodb://localhost:27017/simonev_readmodel

# --- Auth.js ---
# Hasil dari: npx auth secret
AUTH_SECRET=ganti-dengan-secret-acak-minimal-32-karakter
AUTH_URL_OPS=http://localhost:3000
AUTH_URL_EKSEKUTIF=http://localhost:3001

# --- SMTP (F-12 Notifikasi, via Nodemailer) ---
SMTP_HOST=smtp.boyolalikab.go.id
SMTP_PORT=587
SMTP_USER=simonev@boyolalikab.go.id
SMTP_PASSWORD=
SMTP_FROM="SIMONEV Boyolali <simonev@boyolalikab.go.id>"

# --- Validasi Bukti Otomatis (F-04) ---
EVIDENCE_VALIDATION_TIMEOUT_MS=8000

# --- Umum ---
NODE_ENV=development
